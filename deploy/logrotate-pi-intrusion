# logrotate stanza for the pi-intrusion-detection event log.
#
# Install: sudo cp deploy/logrotate-pi-intrusion /etc/logrotate.d/pi-intrusion
# Adjust the path if you changed --log in the systemd unit (the shipped unit
# runs intrusion.py with its default `events.jsonl` in WorkingDirectory, and
# the dashboard reads `%h/projects/pi-intrusion-detection/events.jsonl`).
# `%h` is systemd syntax; logrotate does not expand it, so use a glob
# that matches the checkout under any user's home directory.
/home/*/projects/pi-intrusion-detection/events.jsonl {
    daily
    rotate 7
    compress
    delaycompress
    missingok
    notifempty
    # rename rotation instead of copytruncate: the detector reopens the log
    # per line, so a rename cycle loses nothing, and the fresh file is
    # owned by pi (create) so writes keep succeeding.
    su pi pi
    create 0640 pi pi
}