# Copy to /etc/pi-intrusion.env (owned by root, chmod 600) and fill in values.
# This file is gitignored and referenced by deploy/pi-intrusion-detection.service.
# Both are optional: alerts are silently off unless both are set.

# Bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your chat id (ask @userinfobot for it)
TELEGRAM_CHAT_ID=