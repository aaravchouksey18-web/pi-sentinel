[Unit]
Description=pi-intrusion-detection headless sentry
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/projects/pi-intrusion-detection
# Replace <CAMERA_URL> with your stream (e.g. http://192.0.2.50:81/stream)
# or a device index (e.g. /dev/video0).
ExecStart=/usr/bin/python3 /home/pi/projects/pi-intrusion-detection/intrusion.py \
    --stream <CAMERA_URL> \
    --headless \
    --mqtt-broker 127.0.0.1 \
    --mqtt-topic intrusion/events \
    --snapshot-dir /home/pi/snapshots
# Telegram tokens etc. live here, outside the repo (see pi-intrusion.env.example)
EnvironmentFile=/etc/pi-intrusion.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target