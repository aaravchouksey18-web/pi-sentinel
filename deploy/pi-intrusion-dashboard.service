[Unit]
Description=pi-intrusion-detection web dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/projects/pi-intrusion-detection
ExecStart=/usr/bin/python3 /home/pi/projects/pi-intrusion-detection/dashboard.py \
    --log /home/pi/projects/pi-intrusion-detection/events.jsonl \
    --snapshot-dir /home/pi/snapshots \
    --port 8001
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target